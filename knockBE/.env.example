# StocKKnock Backend (Spring Boot) — 예시만. 실제 값은 .env 에 넣고 커밋하지 마세요.
# 사용: cp .env.example .env  후 값 채우기
# 실행: set -a && source .env && set +a && ./gradlew bootRun
#
# ─── 프로필 선택 ──────────────────────────────────────────────────────────────
# 로컬 Postgres   → SPRING_PROFILES_ACTIVE 설정 불필요 (기본값)
# Supabase        → SPRING_PROFILES_ACTIVE=supabase
#
# SPRING_PROFILES_ACTIVE=supabase

# ─── Database ─────────────────────────────────────────────────────────────────
# [로컬]
DB_URL=jdbc:postgresql://localhost:5432/stockknockdb
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password_here

# [Supabase] — 위 세 줄 대신 아래 형식으로 교체 (sslmode=require 필수)
# Supabase 대시보드 > Project Settings > Database > Connection String (URI) 참고
# DB_URL=jdbc:postgresql://aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USERNAME=postgres.your-project-ref
# DB_PASSWORD=your_supabase_db_password_here

# ─── JWT (필수, 64 bytes 이상) ────────────────────────────────────────────────
# 생성: openssl rand -base64 64 | tr -d '\n'
SKJWT_SECRET=your_jwt_secret_here_min_64_bytes

# ─── OpenAI (필수) ────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
GPT_MODEL=gpt-4o-mini

# ─── FastAPI 내부 호출 ────────────────────────────────────────────────────────
FASTAPI_BASE_URL=http://localhost:8000

# ─── Mail (선택) ──────────────────────────────────────────────────────────────
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your_mail_app_password_here
NOTIFICATION_EMAIL_ENABLED=false

# ─── Stock APIs (선택) ────────────────────────────────────────────────────────
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
TWELVE_DATA_API_KEY=your_twelve_data_key_here

# ─── CORS (배포 시 교체) ──────────────────────────────────────────────────────
# CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
