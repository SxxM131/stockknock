# StocKKnock AI (FastAPI) — 예시만. 실제 값은 .env 에 넣고 커밋하지 마세요.
# python-dotenv 가 자동으로 .env 를 로드합니다.
#
# ─── 프로필 선택 ──────────────────────────────────────────────────────────────
# 로컬 Postgres   → .env 에 DATABASE_URL 설정 (아래 로컬 예시)
# Supabase        → .env.supabase 파일을 만들고 SUPABASE=1 환경 변수 설정,
#                   또는 .env.supabase 파일이 있으면 자동으로 우선 로드됩니다.
#
#   cp .env.example .env.supabase
#   # .env.supabase 에서 DATABASE_URL 을 Supabase 형식으로 교체
#   SUPABASE=1 uvicorn app.main:app --reload

# ─── Database ─────────────────────────────────────────────────────────────────
# [로컬]
# 형식: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://your_db_user:your_db_password_here@localhost:5432/stockknockdb

# [Supabase] — .env.supabase 에 아래 형식으로 설정 (sslmode=require 필수)
# Supabase 대시보드 > Project Settings > Database > Connection String (URI) 참고
# DATABASE_URL=postgresql://postgres.your-project-ref:your_password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require
#
# SSL 을 URL 쿼리 대신 별도 변수로 설정하고 싶을 때:
# DB_SSLMODE=require

# ─── OpenAI (필수) ────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
GPT_MODEL=gpt-4o-mini

# ─── Stock APIs (선택) ────────────────────────────────────────────────────────
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
TWELVE_DATA_API_KEY=your_twelve_data_key_here
YAHOO_FINANCE_ENABLED=false

# ─── News API (선택) ──────────────────────────────────────────────────────────
NEWS_API_KEY=your_newsapi_key_here
